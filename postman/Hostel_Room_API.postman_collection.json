              "pm.test(\"TC-07: error names the missing fields\", function () { const d = pm.response.json().details; pm.expect(d).to.have.property(\"block\"); pm.expect(d).to.have.property(\"capacity\"); pm.expect(d).to.have.property(\"monthly_fee\"); });"
            ]
          }
        }
      ]
    },
